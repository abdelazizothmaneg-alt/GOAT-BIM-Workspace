<Window x:Class="ORTools.UI.GoatRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | GOAT ROOM — Glyph-Style Room Documentation &amp; Sheet Bundle Engine"
        Width="1280" Height="810"
        MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP DARK NAVY BANNER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="48" Height="48" Background="Black" BorderBrush="White" BorderThickness="1.5" CornerRadius="6" Margin="0,0,14,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="GOAT" Foreground="White" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="ROOM" Foreground="#10B981" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GOAT ROOM — Automated Room Documentation &amp; Sheet Bundle Engine" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Enlarged Plan · RCP · 4-Way or Wall-Parallel Interior Elevations · 3D Iso · One-Click Auto-Dim, Auto-Tag &amp; Sheet Packing" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Revit 2026 / 2027 (.NET 10)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Text="● Bundle Copilot Ready" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3-COLUMN WORKSPACE -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="425"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: ROOM LIST (Editable Number, Name & Fill Color Picker) -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <TextBlock Text="1. Rooms — Edit Number, Name &amp; View Fill Color" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSelectedCount" Text="0 Selected" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="10,8,10,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <RadioButton x:Name="RbActiveView" Grid.Column="0" Content="Active View" IsChecked="True" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,12,0" Checked="Scope_Changed"/>
                        <RadioButton x:Name="RbEntireProject" Grid.Column="1" Content="Entire Project" FontWeight="SemiBold" FontSize="11.5" Checked="Scope_Changed"/>
                        <Button Grid.Column="3" Content="🔄" Click="BtnRefresh_Click" Padding="6,2" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" ToolTip="Rescan Rooms"/>
                    </Grid>
                    <Border Grid.Row="2" Margin="10,2,10,8" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                        <DataGrid x:Name="DgRooms"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FAFC"
                                  BorderThickness="0"
                                  RowHeight="29"
                                  FontSize="11.5">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="✔" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                                <DataGridTextColumn Header="No. (✎)" Binding="{Binding RoomNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Room Name (✎)" Binding="{Binding RoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" IsReadOnly="False"/>
                                <DataGridTemplateColumn Header="Fill Color" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="BtnPickRoomColor_Click"
                                                    Tag="{Binding}"
                                                    Margin="4,3"
                                                    Height="21"
                                                    Background="{Binding FillColorHex}"
                                                    Content="{Binding FillColorHex}"
                                                    Foreground="White"
                                                    FontSize="9.5"
                                                    FontWeight="Bold"
                                                    BorderBrush="#334155"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    ToolTip="Click to pick Fill Color for this room"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="m²" Binding="{Binding AreaSqm}" Width="52" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Grid Grid.Row="3" Margin="10,0,10,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Select All" Click="BtnSelectAll_Click" FontSize="11" Padding="8,4" Margin="0,0,6,0" Background="White" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="Select None" Click="BtnSelectNone_Click" FontSize="11" Padding="8,4" Background="White" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        <Button Grid.Column="3" Content="🎨 Auto-Color By Name" Click="BtnAutoColorRooms_Click" FontSize="11" Padding="10,4" Background="#E0F2FE" BorderBrush="#38BDF8" Foreground="#0369A1" FontWeight="Bold" Cursor="Hand" ToolTip="Assign matching colors by Room Name"/>
                    </Grid>
                    <Button Grid.Row="4" Content="💾 Apply Names, Numbers &amp; Fill Colors to View Now" Click="BtnApplyRoomEditsAndColors_Click" Margin="10,0,10,10" Height="32" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="Save edited Room Names/Numbers &amp; apply Room Fill Colors in Active View"/>
                </Grid>
            </Border>

            <!-- MIDDLE: VIEWS & ONE-CLICK BUNDLE SETTINGS -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="2. Room Views to Generate" Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,12"/>

                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <CheckBox x:Name="ChkGenPlan" Content="Enlarged Floor Plan" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkGenRcp" Content="Reflected Ceiling Plan (RCP)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkGenElevations" Content="Interior Elevations" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkGen3DIso" Content="3D Room Isometric (Section Box)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        </UniformGrid>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Interior Elevations Orientation Mode:" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                <RadioButton x:Name="RbElev4Way" Content="Standard 4-Way (North, South, East, West) at Room Center" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,6" Checked="Setting_Changed"/>
                                <RadioButton x:Name="RbElevAllWalls" Content="Parallel to All Room Walls (Includes Angled &amp; L-Shape Walls)" FontWeight="SemiBold" Checked="Setting_Changed"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="85"/><ColumnDefinition Width="24"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Crop Boundary Offset:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCropOffset" Grid.Column="1" Text="250" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                            <TextBlock Grid.Column="3" Text="View Scale 1 :" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtViewScale" Grid.Column="4" Text="50" Height="28" Width="75" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="View Naming Formula:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtNamingFormula" Grid.Column="1" Text="RM-{Number} - {Name} - {Type}" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1"/>
                        </Grid>

                        <!-- GLYPH BUNDLE WORKFLOW -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="3. One-Click Task Bundle (Glyph Copilot Workflow)" Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkApplyRoomFillColors" Content="Apply Room Names/Numbers &amp; Room Fill Colors in View" IsChecked="True" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkBundleAutoDim" Content="Auto-Dimension Generated Plans &amp; Elevations (via GOAT DIM)" IsChecked="True" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkBundleAutoTag" Content="Auto-Tag Doors, Windows, Plumbing &amp; Casework (via GOAT ANNOTATE)" IsChecked="True" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkBundlePackSheet" Content="Create Dedicated Sheet per Room &amp; Auto-Pack All Views (via GOAT ALIGNER)" IsChecked="True" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,12" Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sheet Titleblock:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CbTitleBlocks" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sheet Number Prefix:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtSheetPrefix" Grid.Column="1" Text="ID-" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                    <TextBlock Grid.Column="2" Text="(e.g. ID-101 — Room Name)" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: SHEET AUTO-PACK PREVIEW -->
            <Border Grid.Column="4" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,8">
                        <TextBlock Text="BUNDLE PREVIEW: Sheet Auto-Pack Layout" Foreground="#0F172A" FontSize="11.5" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Row="1" Background="#F8FAFC" Padding="12">
                        <Canvas x:Name="CanvasSheetPreview" ClipToBounds="True" SizeChanged="CanvasSheetPreview_SizeChanged"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="6" Padding="16,10">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready — Select rooms and run One-Click Room Documentation Bundle." Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Click="BtnClose_Click" Height="36" Padding="16,0" Margin="0,0,10,0" Background="White" BorderBrush="#94A3B8" Foreground="#0F172A" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="🚀 Generate Room Bundle" Click="BtnGenerate_Click" Height="36" Padding="24,0" Background="#0F172A" BorderThickness="0" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
