<Window x:Class="ORTools.UI.GoatBoqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | GOAT BOQ — Automated Model Quantity Takeoff (QTO) &amp; BOQ Excel Builder"
        Width="1160" Height="740"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP DARK NAVY BANNER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="48" Height="48" Background="Black" BorderBrush="White" BorderThickness="1.5" CornerRadius="6" Margin="0,0,14,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="GOAT" Foreground="White" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="BOQ" Foreground="#10B981" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GOAT BOQ — Automated Model Quantity Takeoff (QTO) &amp; BOQ Excel Builder" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Multi-Category QTO (Count, Length m, Area m², Volume m³) · Editable Unit Rates · Multi-Sheet .XLSX BOQ Export" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Rescan Model QTO" Click="BtnRescan_Click" Height="34" Padding="14,0" Margin="0,0,8,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="📊 Export BOQ to .XLSX" Click="BtnExportXlsx_Click" Height="34" Padding="16,0" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTER & SCOPE BAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Scope:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton x:Name="RbEntireModel" Grid.Column="1" Content="Whole Model" IsChecked="True" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" Checked="Scope_Changed"/>
                <RadioButton x:Name="RbActiveView" Grid.Column="2" Content="Active View" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" Checked="Scope_Changed"/>

                <TextBox x:Name="TxtFilter" Grid.Column="3" Height="28" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1" TextChanged="TxtFilter_TextChanged"/>
                <TextBlock Grid.Column="4" Text="🔍 Filter by Category, Family, Type or Level" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <CheckBox x:Name="ChkGroupByLevel" Grid.Column="5" Content="Break down by Level" IsChecked="False" FontWeight="SemiBold" VerticalAlignment="Center" Checked="Scope_Changed" Unchecked="Scope_Changed"/>
            </Grid>
        </Border>

        <!-- BOQ DATAGRID -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,12">
            <DataGrid x:Name="DgBoq"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      RowHeight="30"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✔" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                    <DataGridTextColumn Header="BOQ Code" Binding="{Binding ItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="135" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Family &amp; Type Description" Binding="{Binding TypeDescription}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Count (pcs)" Binding="{Binding Count}" Width="85" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Length (m)" Binding="{Binding TotalLengthM, StringFormat=N2}" Width="95" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Net Area (m²)" Binding="{Binding TotalAreaSqm, StringFormat=N2}" Width="105" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Volume (m³)" Binding="{Binding TotalVolumeCum, StringFormat=N2}" Width="95" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Primary Unit" Binding="{Binding PrimaryUnit}" Width="85" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Primary Qty" Binding="{Binding PrimaryQuantity, StringFormat=N2}" Width="95" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="3" Background="#E2E8F0" CornerRadius="6" Padding="16,10">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready — Scanning model quantities..." Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Close" Click="BtnClose_Click" HorizontalAlignment="Right" Height="34" Padding="18,0" Background="#0F172A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
