<Window x:Class="ORTools.UI.OrSheetLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | GOAT SHEETLINK — Bidirectional Excel &amp; Live Spreadsheet Parameter Editor"
        Height="780" Width="1260"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP DARK NAVY BANNER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="pack://application:,,,/ORTools;component/Resources/SHEETLINK.jpg" Width="46" Height="46" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GOAT SHEETLINK — Bidirectional Excel &amp; Live Spreadsheet Editor" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="1. Choose Category or Schedule  |  2. Customize Parameter Columns  |  3. Edit Live in Table or Export/Import Excel &amp; Sync Back to Revit" Foreground="#CBD5E1" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportToExcelXlsxCommand}" Content="📊 Export Native .XLSX (Instances + Types)" Height="34" Padding="14,0" Margin="0,0,8,0" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    <Button Command="{Binding ExportToExcelCsvCommand}" Content="📤 Export .CSV" Height="34" Padding="12,0" Margin="0,0,8,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    <Button Command="{Binding ImportFromExcelCsvCommand}" Content="📥 Import .XLSX / .CSV" Height="34" Padding="14,0" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SCOPE & PROGRESS BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshModelCommand}" Content="🔄 Rescan Model" Height="30" Padding="10,0" Margin="0,0,14,0" Background="#E2E8F0" BorderBrush="#94A3B8" FontWeight="Bold"/>
                <TextBlock Text="Selection Scope:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                <RadioButton Content="Whole Model" IsChecked="{Binding IsWholeModelScope}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,14,0"/>
                <RadioButton Content="Active View" IsChecked="{Binding IsActiveViewScope}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,20,0"/>
                <Button Command="{Binding SelectAllRowsInRevitCommand}" Content="👁 Select Filtered Rows in Revit" Height="30" Padding="12,0" Background="#FEF3C7" BorderBrush="#F59E0B" Foreground="#92400E" FontWeight="Bold"/>
            </StackPanel>

            <Grid Grid.Column="2" Height="28">
                <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Background="#E2E8F0" Foreground="#10B981" BorderBrush="#CBD5E1"/>
                <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0F172A"/>
            </Grid>
        </Grid>

        <!-- 3. MAIN WORKSPACE: LEFT CONFIG (Category + Columns) & RIGHT LIVE SPREADSHEET EDITOR -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: SOURCE & PARAMETER COLUMNS SELECTOR -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="1.35*"/>
                </Grid.RowDefinitions>

                <!-- STEP 1: Select Category or Schedule -->
                <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#0F172A" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                            <TextBlock Text="1. Select Data Source (Categories or Schedules)" Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="Categories" IsChecked="{Binding IsCategoriesMode}" FontWeight="Bold" Margin="0,0,18,0"/>
                            <RadioButton Content="Schedules" IsChecked="{Binding IsSchedulesMode}" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBox Grid.Row="2" Text="{Binding SourceSearchText, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,6" BorderBrush="#CBD5E1" ToolTip="Search category or schedule"/>
                        <ListBox Grid.Row="3" ItemsSource="{Binding FilteredSourceItems}" SelectedItem="{Binding SelectedSourceItem}" DisplayMemberPath="DisplayLabel" BorderBrush="#CBD5E1"/>
                    </Grid>
                </Border>

                <!-- STEP 2: Choose & Order Parameter Columns -->
                <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#0F172A" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                            <TextBlock Text="2. Customize Parameter Columns (Instance &amp; Type)" Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <TextBox Grid.Row="1" Text="{Binding ParamSearchText, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,6" BorderBrush="#CBD5E1" ToolTip="Filter available parameters"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Available Parameters -->
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="Available Parameters" FontWeight="SemiBold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                <ListBox ItemsSource="{Binding AvailableParameters}" SelectedItem="{Binding SelectedAvailableParameter}" BorderBrush="#CBD5E1" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackgroundHex}" Padding="4,2" Margin="0,1">
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Add / Remove / Order Buttons -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                <Button Command="{Binding AddParameterColumnCommand}" Content="▶" Height="28" Margin="0,0,0,6" FontWeight="Bold" ToolTip="Add selected parameter to table"/>
                                <Button Command="{Binding RemoveParameterColumnCommand}" Content="◀" Height="28" Margin="0,0,0,10" FontWeight="Bold" ToolTip="Remove parameter from table"/>
                                <Button Command="{Binding MoveColumnUpCommand}" Content="▲" Height="26" Margin="0,0,0,4" ToolTip="Move column left/up"/>
                                <Button Command="{Binding MoveColumnDownCommand}" Content="▼" Height="26" ToolTip="Move column right/down"/>
                            </StackPanel>

                            <!-- Active Table Columns -->
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="Active Table Columns" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" Margin="0,0,0,4"/>
                                <ListBox ItemsSource="{Binding SelectedParameters}" SelectedItem="{Binding SelectedActiveParameter}" BorderBrush="#CBD5E1" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackgroundHex}" Padding="4,2" Margin="0,1">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Command="{Binding AddAllParametersCommand}" Content="+ Add All Editable" Height="26" Padding="8,0" Margin="0,0,6,0" Background="#E8F5E9" BorderBrush="#81C784" Foreground="#1B5E20" FontWeight="SemiBold"/>
                            <Button Command="{Binding ClearParametersCommand}" Content="Clear Columns" Height="26" Padding="8,0" Background="#FEE2E2" BorderBrush="#EF4444" Foreground="#991B1B" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT PANEL: INTERACTIVE EXCEL-LIKE SPREADSHEET EDITOR & BULK TOOLS -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Spreadsheet Header & Search Filter -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="3. Live Editable Spreadsheet (Edit Cells Directly or Use Bulk Tools Below)" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="🔍 Quick Filter Rows:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#475569"/>
                            <TextBox Text="{Binding GridFilterText, UpdateSourceTrigger=PropertyChanged}" Width="210" Height="26" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bulk Find & Replace + Column Auto-Fill Toolbar -->
                    <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="2" Text="Replace:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="3" Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,6,0"/>
                            <Button Grid.Column="4" Command="{Binding ApplyFindReplaceInGridCommand}" Content="Replace All" Height="26" Padding="8,0" Background="#E2E8F0" FontWeight="SemiBold"/>

                            <TextBlock Grid.Column="6" Text="Bulk Fill Column:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="7" ItemsSource="{Binding EditableColumnNames}" SelectedItem="{Binding TargetColumnForFill}" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="8" Text="{Binding BulkFillValueText, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,6,0" ToolTip="Use {#} for auto-numbering (e.g. RM-{#})"/>
                            <Button Grid.Column="9" Command="{Binding ApplyBulkFillColumnCommand}" Content="Fill Column" Height="26" Padding="10,0" Background="#FEF3C7" BorderBrush="#F59E0B" Foreground="#92400E" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Text="Tip: Edit any cell directly, use {#} in Bulk Fill for sequential numbering (e.g. A-{#} -> A-01, A-02), or Export to Excel -> Edit -> Import CSV -> Sync to Revit!" Foreground="#64748B" FontSize="11" Margin="0,0,0,6"/>

                    <!-- Live Editable DataGrid bound to DataView -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding LiveDataView}"
                              AutoGenerateColumns="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeight="28"
                              BorderBrush="#CBD5E1"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E2E8F0"
                              VerticalGridLinesBrush="#E2E8F0"
                              AlternatingRowBackground="#F8FAFC"/>

                    <!-- Bottom Action Bar inside Spreadsheet Panel -->
                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RowCountLabel}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding AddNewElementRowCommand}" Content="➕ Add New Sheet / Room Row" Height="36" Padding="14,0" Margin="0,0,10,0" Background="#DCFCE7" BorderBrush="#10B981" Foreground="#065F46" FontWeight="Bold" ToolTip="Append a 'NEW' row to create a new Placeholder Sheet or Unplaced Room upon Sync"/>
                            <Button Command="{Binding ReloadGridFromRevitCommand}" Content="↩ Discard &amp; Reload from Model" Height="36" Padding="14,0" Margin="0,0,10,0" Background="White" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                            <Button Command="{Binding PushChangesToRevitCommand}" Content="🚀 Sync Changes to Revit Model Now" Height="36" Padding="20,0" Background="#0F172A" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. FOOTER STATUS BAR -->
        <Border Grid.Row="3" Background="#E2E8F0" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#0F172A" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
