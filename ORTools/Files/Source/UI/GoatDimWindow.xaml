<Window x:Class="ORTools.UI.GoatDimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | GOAT DIM — Automated Room, Exterior &amp; Elevation Dimensioning Engine"
        Width="860" Height="580"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP DARK NAVY BANNER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="48" Height="48" Background="Black" BorderBrush="White" BorderThickness="1.5" CornerRadius="6" Margin="0,0,14,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="GOAT" Foreground="White" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="DIM" Foreground="#10B981" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GOAT DIM — Automated Interior Room, Exterior Building &amp; Elevation Dimensioning" Foreground="White" FontSize="16.5" FontWeight="Bold"/>
                    <TextBlock Text="Auto-Raycast Room Cross Dimensions · Stacked Exterior Chains (Walls &amp; Grids) · Vertical Elevation Datum Chains" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Revit 2026 / 2027 (.NET 10)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Text="● Raycast Ready" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Dimension Type Selector -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Linear Dimension Style:" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CbDimTypes" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
                </Grid>

                <!-- Mode Selector -->
                <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="1. Select Dimensioning Mode for Active View" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <RadioButton x:Name="RbModeInteriorRooms" Content="Mode A: Interior Room Dimensions (Clear X/Y Span + Door/Window Opening Chains in Rooms)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <RadioButton x:Name="RbModeExteriorBuilding" Content="Mode B: Exterior Building Perimeter Chains (Stacked Grids Chain + Exterior Walls Chain)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <RadioButton x:Name="RbModeElevationLevels" Content="Mode C: Elevation / Section Vertical Datum Chain (Automatic Level-to-Level Heights)" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Detailed Settings -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="2. Wall Offset, Chain Stacking &amp; Unit Formatting" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkRoomClearCross" Content="Include Room Overall Clear Width × Length Cross Dimensions" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkRoomOpenings" Content="Include Secondary Chain for Door &amp; Window Openings in Room Walls" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkExtGrids" Content="Include Structural Grids Dimension Chain (Exterior Mode)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkShowMmSuffix" Content="Show 'mm' Unit Suffix Next to Dimension Numbers (e.g. 1500 mm)" IsChecked="True" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Room Offset from Wall (mm):" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtWallOffset" Grid.Column="1" Text="500" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#0284C7" FontWeight="Bold"/>

                            <TextBlock Grid.Column="3" Text="Chain Stack Offset (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtStackOffset" Grid.Column="4" Text="450" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>

                            <TextBlock Grid.Column="6" Text="Exterior Base Offset (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtExteriorOffset" Grid.Column="7" Text="1200" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="6" Padding="16,10">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready — Active View will be dimensioned in 1 step (1x Ctrl+Z)." Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Click="BtnClose_Click" Height="36" Padding="16,0" Margin="0,0,10,0" Background="White" BorderBrush="#94A3B8" Foreground="#0F172A" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="🚀 Generate Dimensions" Click="BtnGenerate_Click" Height="36" Padding="24,0" Background="#0F172A" BorderThickness="0" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
