<Window x:Class="ORTools.UI.OrParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | GOAT PARAMETER — Bulk Instance &amp; Type Parameter Editor"
        Height="680" Width="960"
        MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP DARK NAVY BANNER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="pack://application:,,,/ORTools;component/Resources/PARAMETER.jpg" Width="44" Height="44" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GOAT PARAMETER — Bulk Instance &amp; Type Parameter Editor" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Filter by Parameter Value (Case Sensitive) · Select in Revit · Add Prefix/Suffix · Bulk Overwrite &amp; Clear Values" Foreground="#CBD5E1" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SCOPE & PROGRESS BAR ROW (DiRoots OneParameter Top Bar) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ClearInputsCommand}" ToolTip="Clear all inputs and refresh parameters" Width="34" Height="32" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderBrush="#D97706" Margin="0,0,14,0" Content="🗑"/>
                <RadioButton Content="Whole Model" IsChecked="{Binding IsWholeModelScope}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <RadioButton Content="Active View" IsChecked="{Binding IsActiveViewScope}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="2" Height="28">
                <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Background="#E2E8F0" Foreground="#10B981" BorderBrush="#CBD5E1"/>
                <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0F172A"/>
            </Grid>
        </Grid>

        <!-- 3. MAIN SPLIT WORKSPACE (Left: Select Parameter | Right: Filter, Prefix/Suffix, Overwrite/Clear) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: SELECT PARAMETER -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
                        <TextBlock Text="Select Parameter" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#0F172A"/>
                    </Border>

                    <!-- Instance / Type Filter ComboBox -->
                    <ComboBox Grid.Row="1" SelectedIndex="{Binding ScopeFilterModeIndex}" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,8">
                        <ComboBoxItem Content="Instance, Type"/>
                        <ComboBoxItem Content="Instance Only"/>
                        <ComboBoxItem Content="Type Only"/>
                    </ComboBox>

                    <!-- Search Parameter Box -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <TextBox Text="{Binding SearchParameterText, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Padding="6,0,26,0" BorderBrush="#CBD5E1" ToolTip="Search parameter by name"/>
                        <TextBlock Text="🔍" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False" Foreground="#64748B"/>
                    </Grid>

                    <!-- Parameters ListView with Color-Coded Rows (Green=Instance, Amber=Type) -->
                    <ListBox Grid.Row="3" ItemsSource="{Binding FilteredParameters}" SelectedItem="{Binding SelectedParameter}" BorderBrush="#CBD5E1" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RowBackgroundHex}" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ParameterScopeLabel}" Foreground="{Binding BadgeForegroundHex}" FontSize="11" FontWeight="Bold" Margin="8,0"/>
                                        <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="6,1">
                                            <TextBlock Text="{Binding ElementCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bottom Sort Legend Buttons (Instance / Type) -->
                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Instance" Command="{Binding SortInstanceCommand}" Height="32" Background="#E8F5E9" BorderBrush="#81C784" Foreground="#1B5E20" FontWeight="Bold" ToolTip="Click to sort Instance parameters to top"/>
                        <Button Grid.Column="2" Content="Type" Command="{Binding SortTypeCommand}" Height="32" Background="#FFF3E0" BorderBrush="#FFB74D" Foreground="#E65100" FontWeight="Bold" ToolTip="Click to sort Type parameters to top"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: ACTIONS (Filter by Value, Prefix/Suffix, Overwrite & Clear) -->
            <StackPanel Grid.Column="2">

                <!-- SECTION A: Filter by Parameter Value -->
                <GroupBox Header="Filter by Parameter Value" Padding="14" Margin="0,0,0,16" BorderBrush="#CBD5E1" Background="White">
                    <StackPanel>
                        <TextBlock Text="Enter a value to filter elements owning the selected parameter (leave empty to target all):" Foreground="#64748B" FontSize="11" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ValueFilterText, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1"/>
                            <ToggleButton Grid.Column="2" Content="Aa" IsChecked="{Binding IsCaseSensitive}" Height="32" FontWeight="Bold" ToolTip="Enable/Disable Case Sensitive matching"/>
                            <Button Grid.Column="4" Content="👁" Command="{Binding SelectInRevitCommand}" Height="32" FontSize="15" ToolTip="Select in Revit: Highlight matching elements in active model view"/>
                            <Button Grid.Column="6" Content="Find" Command="{Binding FindByValueCommand}" Height="32" Background="#E2E8F0" BorderBrush="#94A3B8" FontWeight="Bold" ToolTip="Count matching elements"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- SECTION B: Prefix / Suffix (Enabled ONLY for StorageType.String) -->
                <GroupBox Header="Prefix / Suffix (String Parameters Only)" Padding="14" Margin="0,0,0,16" BorderBrush="#CBD5E1" Background="White" IsEnabled="{Binding IsPrefixSuffixEnabled}">
                    <StackPanel>
                        <TextBlock Text="Formula: NewValue = Prefix + CurrentValue + Suffix (Automatically disabled for non-string parameters)" Foreground="#64748B" FontSize="11" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Prefix:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding PrefixText, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1"/>
                            <Button Grid.Column="3" Content="+" Command="{Binding AddPrefixSuffixCommand}" Height="32" FontSize="16" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" ToolTip="Apply Prefix/Suffix to target elements"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Suffix:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding SuffixText, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1"/>
                            <Button Grid.Column="3" Content="+" Command="{Binding AddPrefixSuffixCommand}" Height="32" FontSize="16" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" ToolTip="Apply Prefix/Suffix to target elements"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- SECTION C: Parameter Value (Bulk Overwrite & Clear Values) -->
                <GroupBox Header="Parameter Value — Bulk Overwrite &amp; Clear" Padding="14" Margin="0,0,0,14" BorderBrush="#CBD5E1" Background="White" IsEnabled="{Binding IsParameterSelected}">
                    <StackPanel>
                        <TextBlock Text="Enter a new value to overwrite all target elements, or click Clear (🧹) to wipe existing values:" Foreground="#64748B" FontSize="11" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding OverwriteValueText, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#CBD5E1"/>
                            <Button Grid.Column="2" Content="🧹 Clear" Command="{Binding ClearValuesCommand}" Height="34" Background="#FEE2E2" BorderBrush="#EF4444" Foreground="#991B1B" FontWeight="Bold" ToolTip="Clear Values (sets String to empty or ElementId to InvalidElementId)"/>
                            <Button Grid.Column="4" Content="⇥ Overwrite" Command="{Binding OverwriteValueCommand}" Height="34" Background="#0F172A" Foreground="White" FontWeight="Bold" ToolTip="Bulk Overwrite parameter value with type validation"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- SECTION D: GOAT BIM Power Utilities (Color Splasher & Spatial Room/Level Injector) -->
                <GroupBox Header="GOAT Power Tools — Color Splasher &amp; Spatial Room / Level Injector" Padding="12" BorderBrush="#CBD5E1" Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ColorSplashCommand}" Content="🎨 Color Splash Active View" Height="34" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" ToolTip="Color-code elements in Active View by distinct values of the selected parameter"/>
                        <Button Grid.Column="2" Command="{Binding ResetColorSplashCommand}" Content="↺ Reset Colors" Height="34" Background="#E2E8F0" Foreground="#0F172A" FontWeight="Bold" BorderBrush="#CBD5E1" ToolTip="Clear all Color Splash graphic overrides in Active View"/>
                        <Button Grid.Column="4" Command="{Binding InjectRoomDataCommand}" Content="🏠 Inject Host Room &amp; Level" Height="34" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" ToolTip="Write spatial Host Room Number/Name &amp; Level into the selected String parameter"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </Grid>

        <!-- 4. FOOTER STATUS & TOTAL ITEMS BAR -->
        <Border Grid.Row="3" Background="#E2E8F0" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalItemsLabel}" VerticalAlignment="Center" Foreground="#0F172A" FontWeight="Bold" FontSize="13"/>
            </Grid>
        </Border>
    </Grid>
</Window>
