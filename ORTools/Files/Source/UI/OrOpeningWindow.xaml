<Window x:Class="ORTools.UI.OrOpeningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | D VIEW &amp; W VIEW — Parametric 4-View Shop Drawing &amp; Sheet Engine"
        Height="860" Width="1260"
        MinHeight="740" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <Style x:Key="AutoMarkCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAutoNumbered}" Value="True">
                    <Setter Property="Background" Value="#FEF3C7"/>
                    <Setter Property="Foreground" Value="#92400E"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP DARK NAVY BANNER (#0F172A) -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderLogo" Grid.Column="0" Source="pack://application:,,,/ORTools;component/Resources/DOOR_VIEW.jpg" Width="46" Height="46" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="D VIEW — Parametric Door 4-View Shop Drawing &amp; Sheet Engine" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Reference Instance Selector · View Type/Template/Scale Matrix · Slab Vertical Extent · Standard Frame/Leaf Dimensions · 4-Quadrant Sheet Layout" Foreground="#CBD5E1" FontSize="11.5" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOOLBAR & PROGRESS -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Command="{Binding ScanModelCommand}" Content="🔄 Rescan Project Types &amp; Templates" Height="30" Padding="12,0" Margin="0,0,8,0" Background="#E2E8F0" FontWeight="Bold"/>
                <Button Command="{Binding RunPreCheckCommand}" Content="🛡 Family Frame/Leaf Health Report" Height="30" Padding="12,0" Margin="0,0,8,0" Background="#FEF3C7" BorderBrush="#F59E0B" Foreground="#92400E" FontWeight="Bold"/>
                <Button Command="{Binding SelectAllCommand}" Content="☑ Check All" Height="30" Padding="10,0" Margin="0,0,6,0" Background="#DBEAFE" Foreground="#1E40AF" FontWeight="SemiBold"/>
                <Button Command="{Binding SelectNoneCommand}" Content="☐ Uncheck All" Height="30" Padding="10,0" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold"/>
            </StackPanel>
            <Grid Grid.Column="2" Height="28">
                <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Background="#E2E8F0" Foreground="#10B981" BorderBrush="#CBD5E1"/>
                <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0F172A"/>
            </Grid>
        </Grid>

        <!-- MAIN WORKSPACE: LEFT (SECTIONS 1 & 2) | RIGHT (TABBED SECTIONS 3, 4, 5, 6, 7) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.18*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: 1. TYPES & REFERENCE INSTANCE + 2. MARK (TAG) SETTINGS -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. DOOR / WINDOW TYPES -->
                <GroupBox x:Name="GrpTypesHeader" Grid.Row="0" Header="1 · Door types" Padding="10" Margin="0,0,0,10" Background="White" BorderBrush="#CBD5E1" FontWeight="Bold" Foreground="#0F172A">
                    <Grid TextBlock.FontWeight="Normal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,8">
                            <RadioButton Content="{Binding SelectionTypesHeader}" IsChecked="{Binding FromSelection}" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <RadioButton Content="{Binding AllTypesHeader}" IsChecked="{Binding AllInProject}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding OpeningTypes}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  BorderBrush="#CBD5E1"
                                  RowHeight="26"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  VerticalGridLinesBrush="#E2E8F0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                                <DataGridTextColumn Header="Family : Type" Binding="{Binding FamilyAndTypeName}" Width="1.45*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Inst." Binding="{Binding InstanceCount}" Width="40" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Mark" Binding="{Binding Mark, UpdateSourceTrigger=PropertyChanged}" Width="68" CellStyle="{StaticResource AutoMarkCellStyle}"/>
                                <DataGridTextColumn Header="Dimensions" Binding="{Binding DimensionsDetectionStatus}" Width="115" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Reference instance (Level · ID)" Width="1.35*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding ReferenceInstances}"
                                                      SelectedItem="{Binding SelectedReferenceInstance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      VerticalContentAlignment="Center"
                                                      Padding="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2"
                                   Text="One sample opening per type → one set of views per type. The reference instance decides the level, host wall and orientation. Orange mark = auto-numbered."
                                   Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- 2. MARK (TAG) SETTINGS -->
                <GroupBox Grid.Row="1" Header="2 · Mark (tag) settings" Padding="10" Background="White" BorderBrush="#CBD5E1" FontWeight="Bold" Foreground="#0F172A">
                    <StackPanel TextBlock.FontWeight="Normal">
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Read mark from" VerticalAlignment="Center" Foreground="#334155"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ReadMarkSources}" SelectedItem="{Binding ReadMarkFromSource}" Height="26" VerticalContentAlignment="Center"/>
                            <TextBox Grid.Column="3" Text="{Binding CustomMarkParameterName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomMarkParamEnabled}" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="Auto-number empty marks" IsChecked="{Binding AutoNumberEmptyMarks}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock Text="Prefix" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#334155"/>
                            <TextBox Text="{Binding AutoPrefix, UpdateSourceTrigger=PropertyChanged}" Width="55" Height="25" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,14,0"/>
                            <TextBlock Text="Digits" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#334155"/>
                            <TextBox Text="{Binding AutoDigits, UpdateSourceTrigger=PropertyChanged}" Width="42" Height="25" VerticalContentAlignment="Center" Padding="4,0"/>
                        </StackPanel>

                        <CheckBox Content="Write new / edited marks back to the opening types (tags update)" IsChecked="{Binding WriteMarksBackToProject}"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- RIGHT COLUMN: ORGANIZED ENGINEERING TABS FOR SECTIONS 3, 4, 5, 6, 7 -->
            <TabControl Grid.Column="2" Background="White" BorderBrush="#CBD5E1" Padding="8">

                <!-- TAB 1: SECTIONS 3 & 4 (VIEWS TO CREATE + NAMING & OPTIONS) -->
                <TabItem Header="3 &amp; 4 · Views &amp; Naming Options" FontWeight="Bold" Padding="12,5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                        <StackPanel TextBlock.FontWeight="Normal">

                            <!-- 3. VIEWS TO CREATE -->
                            <GroupBox Header="3 · Views to create" Padding="10" Margin="0,4,0,10" Background="White" BorderBrush="#CBD5E1" FontWeight="Bold" Foreground="#0F172A">
                                <Grid TextBlock.FontWeight="Normal">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="68"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="View" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Suffix" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="View type" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="5" Text="Template" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="7" Text="Scale 1:" Foreground="#64748B" FontSize="11"/>

                                    <!-- Row 1: Plan -->
                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="Plan" IsChecked="{Binding IncludePlan}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PlanSuffix, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center" Padding="4,0"/>
                                    <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding PlanViewTypes}" SelectedItem="{Binding SelectedPlanViewType}" Height="25" VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Row="1" Grid.Column="5" ItemsSource="{Binding ViewTemplates}" SelectedItem="{Binding SelectedPlanTemplate}" Height="25" VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Row="1" Grid.Column="7" ItemsSource="{Binding AvailableScales}" SelectedItem="{Binding PlanScale}" Height="25" VerticalContentAlignment="Center"/>

                                    <!-- Row 2: Section -->
                                    <CheckBox Grid.Row="2" Grid.Column="0" Content="Section" IsChecked="{Binding IncludeSection}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SectionSuffix, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center" Padding="4,0"/>
                                    <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding SectionViewTypes}" SelectedItem="{Binding SelectedSectionViewType}" Height="25" VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Row="2" Grid.Column="5" ItemsSource="{Binding ViewTemplates}" SelectedItem="{Binding SelectedSectionTemplate}" Height="25" VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Row="2" Grid.Column="7" ItemsSource="{Binding AvailableScales}" SelectedItem="{Binding SectionScale}" Height="25" VerticalContentAlignment="Center"/>

                                    <!-- Row 3: Elevation -->
                                    <CheckBox Grid.Row="3" Grid.Column="0" Content="Elevation" IsChecked="{Binding IncludeElevation}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ElevationSuffix, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center" Padding="4,0"/>
                                    <ComboBox Grid.Row="3" Grid.Column="3" ItemsSource="{Binding ElevationViewTypes}" SelectedItem="{Binding SelectedElevationViewType}" Height="25" VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Row="3" Grid.Column="5" ItemsSource="{Binding ViewTemplates}" SelectedItem="{Binding SelectedElevationTemplate}" Height="25" VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Row="3" Grid.Column="7" ItemsSource="{Binding AvailableScales}" SelectedItem="{Binding ElevationScale}" Height="25" VerticalContentAlignment="Center"/>

                                    <!-- Row 4: 3D Isolated -->
                                    <CheckBox Grid.Row="4" Grid.Column="0" Content="3D Isolated" IsChecked="{Binding IncludeIso}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding IsoSuffix, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center" Padding="4,0"/>
                                    <ComboBox Grid.Row="4" Grid.Column="3" ItemsSource="{Binding IsoViewTypes}" SelectedItem="{Binding SelectedIsoViewType}" Height="25" VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Row="4" Grid.Column="5" ItemsSource="{Binding ViewTemplates}" SelectedItem="{Binding SelectedIsoTemplate}" Height="25" VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Row="4" Grid.Column="7" ItemsSource="{Binding AvailableScales}" SelectedItem="{Binding IsoScale}" Height="25" VerticalContentAlignment="Center"/>
                                </Grid>
                            </GroupBox>

                            <!-- 4. NAMING & OPTIONS -->
                            <GroupBox Header="4 · Naming &amp; options" Padding="10" Background="White" BorderBrush="#CBD5E1" FontWeight="Bold" Foreground="#0F172A">
                                <StackPanel TextBlock.FontWeight="Normal">
                                    <Grid Margin="0,2,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Name pattern" VerticalAlignment="Center" Foreground="#334155"/>
                                        <TextBox Grid.Column="1" Text="{Binding NamingPattern, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                                    </Grid>
                                    <TextBlock x:Name="LblNamingTokensHelp" Foreground="#64748B" FontSize="11" Margin="105,0,0,8" TextWrapping="Wrap"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblSeparatorHeader" Grid.Column="0" VerticalAlignment="Center" Foreground="#334155"/>
                                        <TextBox Grid.Column="1" Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="any text:  _   -   .   space ..." VerticalAlignment="Center" Foreground="#64748B" FontSize="11" Margin="10,0,0,0"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Crop offset" VerticalAlignment="Center" Foreground="#334155"/>
                                        <TextBox Grid.Column="1" Text="{Binding CropOffsetMm, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                                        <TextBlock Grid.Column="2" Text="mm around the opening" VerticalAlignment="Center" Foreground="#334155" Margin="8,0,0,0"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Look from" VerticalAlignment="Center" Foreground="#334155"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding LookFromIndex}" Height="26" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Exterior side (opening facing)"/>
                                            <ComboBoxItem Content="Interior side (opposite to facing)"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="3D isolate" VerticalAlignment="Center" Foreground="#334155"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding Isolate3DModeIndex}" Height="26" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Opening + host wall"/>
                                            <ComboBoxItem Content="Opening element only"/>
                                            <ComboBoxItem Content="Full 3D section box context"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="If name exists" VerticalAlignment="Center" Foreground="#334155"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding IfNameExistsIndex}" Height="26" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Skip"/>
                                            <ComboBoxItem Content="Replace / Recreate existing view"/>
                                            <ComboBoxItem Content="Append number suffix (_1, _2)"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Opening centre" VerticalAlignment="Center" Foreground="#334155"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding OpeningCentreModeIndex}" Height="26" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Middle of the opening geometry (recommended)"/>
                                            <ComboBoxItem Content="Family insertion point / origin"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Section cut" VerticalAlignment="Center" Foreground="#334155"/>
                                        <TextBox Grid.Column="1" Text="{Binding SectionCutOffsetMm, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                                        <TextBlock Grid.Column="2" Text="mm from centre (+ right / – left, seen from Look from)" VerticalAlignment="Center" Foreground="#334155" FontSize="11" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: SECTIONS 5 & 6 (VERTICAL EXTENT + SHEETS) -->
                <TabItem Header="5 &amp; 6 · Vertical Extent &amp; Sheets" FontWeight="Bold" Padding="12,5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                        <StackPanel TextBlock.FontWeight="Normal">

                            <!-- 5. SECTION / ELEVATION VERTICAL EXTENT -->
                            <GroupBox Header="5 · Section / Elevation vertical extent" Padding="10" Margin="0,4,0,10" Background="White" BorderBrush="#CBD5E1" FontWeight="Bold" Foreground="#0F172A">
                                <StackPanel TextBlock.FontWeight="Normal">
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Bottom" VerticalAlignment="Center" Foreground="#334155"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding BottomExtentModeIndex}" Height="26" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Structural slab below – bottom face"/>
                                            <ComboBoxItem Content="Host wall / Reference level below"/>
                                            <ComboBoxItem Content="Opening bottom edge"/>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="offset" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" Foreground="#334155"/>
                                        <TextBox Grid.Column="3" Text="{Binding BottomOffsetMm, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                                        <TextBlock Grid.Column="4" Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#334155"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Top" VerticalAlignment="Center" Foreground="#334155"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding TopExtentModeIndex}" Height="26" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Structural slab above – top face"/>
                                            <ComboBoxItem Content="Host wall / Level above"/>
                                            <ComboBoxItem Content="Opening top edge"/>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="offset" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" Foreground="#334155"/>
                                        <TextBox Grid.Column="3" Text="{Binding TopOffsetMm, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                                        <TextBlock Grid.Column="4" Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#334155"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Slab =" VerticalAlignment="Center" Foreground="#334155"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SlabFilterModeIndex}" Height="26" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Floor with Structural = Yes"/>
                                            <ComboBoxItem Content="Any Floor element"/>
                                            <ComboBoxItem Content="Floor type name contains"/>
                                        </ComboBox>
                                        <TextBox Grid.Column="3" Text="{Binding SlabFilterText, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                                    </Grid>

                                    <CheckBox Content="Use the same extent for the Section (and the 3D section box)" IsChecked="{Binding UseSameExtentForSectionAnd3D}" Margin="0,0,0,6"/>
                                    <TextBlock Text="No slab found → the opening level / level above is used, and the view is flagged in the report."
                                               Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- 6. SHEETS (NO SCHEDULES!) -->
                            <GroupBox Header="6 · Sheets" Padding="10" Background="White" BorderBrush="#CBD5E1" FontWeight="Bold" Foreground="#0F172A">
                                <StackPanel TextBlock.FontWeight="Normal">
                                    <CheckBox Content="Create one sheet per opening type with its 4 views (No Schedules)" IsChecked="{Binding CreateSheets}" FontWeight="SemiBold" Margin="0,2,0,10"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Title block" VerticalAlignment="Center" Foreground="#334155"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding TitleBlocks}" SelectedItem="{Binding SelectedTitleBlock}" Height="26" VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Sheet number" VerticalAlignment="Center" Foreground="#334155"/>
                                        <TextBox Grid.Column="1" Text="{Binding SheetNumberPattern, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Sheet name" VerticalAlignment="Center" Foreground="#334155"/>
                                        <TextBox Grid.Column="1" Text="{Binding SheetNamePattern, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Layout" VerticalAlignment="Center" Foreground="#334155"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SheetLayoutModeIndex}" Height="26" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Auto: Plan + Elevation top · Section + 3D bottom"/>
                                            <ComboBoxItem Content="Auto: Elevation + Section top · Plan + 3D bottom"/>
                                            <ComboBoxItem Content="Single horizontal row (Plan · Section · Elevation · 3D)"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Background="#0F172A" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Precision TitleBlock Usable-Bounds Quadrant Engine:" Foreground="#38BDF8" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Top-Left: [1] Plan View          • Top-Right: [2] Elevation View" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="• Bot-Left: [3] Section View       • Bot-Right: [4] 3D ISO View" Foreground="White" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: SECTION 7 (STANDARD DIMENSIONS MATRIX & FRAME/LEAF DETECTION) -->
                <TabItem Header="7 · Standard Dimensions" FontWeight="Bold" Padding="12,5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                        <GroupBox Header="7 · Standard dimensions" Padding="10" Margin="0,4,0,0" Background="White" BorderBrush="#CBD5E1" FontWeight="Bold" Foreground="#0F172A">
                            <StackPanel TextBlock.FontWeight="Normal">
                                <CheckBox Content="Dimension the frame and leaf/glazing in the new Plan / Section / Elevation"
                                          IsChecked="{Binding EnableStandardDimensions}" FontWeight="SemiBold" Margin="0,2,0,8"/>

                                <DataGrid ItemsSource="{Binding DimensionRows}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          Height="218"
                                          BorderBrush="#CBD5E1"
                                          RowHeight="24"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E2E8F0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Dimension" Binding="{Binding DimensionName}" Width="*" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="Plan" Binding="{Binding InPlan, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                        <DataGridCheckBoxColumn Header="Section" Binding="{Binding InSection, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                                        <DataGridCheckBoxColumn Header="Elevation" Binding="{Binding InElevation, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Inner string = leaf, outer string = frame. Frame face width turns the leaf string into face | leaf | face."
                                           Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,8"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Reference source" VerticalAlignment="Center" Foreground="#334155"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding ReferenceSourceIndex}" Height="25" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Auto: family references, then frame / panel geometry (recommended)"/>
                                        <ComboBoxItem Content="Family reference planes only"/>
                                        <ComboBoxItem Content="Solid geometry faces (Frame &amp; Leaf subcategories)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="If not found" VerticalAlignment="Center" Foreground="#334155"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding IfRefNotFoundIndex}" Height="25" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Place a text label with the value, and flag it in the report"/>
                                        <ComboBoxItem Content="Dimension overall bounding box only"/>
                                        <ComboBoxItem Content="Skip missing dimension string"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dimension type" VerticalAlignment="Center" Foreground="#334155"/>
                                    <TextBlock Grid.Column="1" Text="Plan" VerticalAlignment="Center" Foreground="#64748B" FontSize="11"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding DimensionTypes}" SelectedItem="{Binding SelectedPlanDimType}" Height="25" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Section" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" Foreground="#64748B" FontSize="11"/>
                                    <ComboBox Grid.Column="4" ItemsSource="{Binding DimensionTypes}" SelectedItem="{Binding SelectedSectionDimType}" Height="25" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="Elevation" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" Foreground="#64748B" FontSize="11"/>
                                    <ComboBox Grid.Column="6" ItemsSource="{Binding DimensionTypes}" SelectedItem="{Binding SelectedElevationDimType}" Height="25" VerticalContentAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Spacing" Width="110" VerticalAlignment="Center" Foreground="#334155"/>
                                    <TextBlock Text="First string" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#334155"/>
                                    <TextBox Text="{Binding FirstStringSpacingMm, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                                    <TextBlock Text="mm   Between strings" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="#334155"/>
                                    <TextBox Text="{Binding BetweenStringsSpacingMm, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                                    <TextBlock Text="mm on paper – same at any scale" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#64748B" FontSize="11"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Double openings" VerticalAlignment="Center" Foreground="#334155"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding DoubleDoorsDimModeIndex}" Height="25" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Leaf width per leaf + overall frame"/>
                                        <ComboBoxItem Content="Overall leaf width + overall frame"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Expandable Parameter Names for Text Labels -->
                                <Expander Header="Parameter names for text labels" IsExpanded="False" Margin="0,2,0,6" Foreground="#0F172A" FontWeight="SemiBold">
                                    <Grid Margin="0,6,0,4" TextBlock.FontWeight="Normal">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Frame width" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ParamFrameWidth}" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Frame height" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding ParamFrameHeight}" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Leaf width" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ParamLeafWidth}" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Leaf height" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding ParamLeafHeight}" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Frame thickness" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ParamFrameThickness}" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Frame face width" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding ParamFrameFaceWidth}" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Leaf thickness" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ParamLeafThickness}" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Undercut" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding ParamUndercut}" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                                    </Grid>
                                </Expander>

                                <!-- Expandable Frame / Leaf Detection -->
                                <Expander Header="Frame / leaf detection (Auto)" IsExpanded="True" Foreground="#0F172A" FontWeight="SemiBold">
                                    <StackPanel Margin="0,6,0,0" TextBlock.FontWeight="Normal">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Frame subcategory / material contains" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding FrameSubcategoryKeywords, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Leaf subcategory / material contains" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding LeafSubcategoryKeywords, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Padding="4,0"/>
                                        </Grid>
                                        <TextBlock Text="Comma separated. Also matched against nested family names. The Dimensions column in section 1 shows what each type gives."
                                                   Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </GroupBox>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- FOOTER BAR -->
        <Border Grid.Row="3" Background="#E2E8F0" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#0F172A" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Command="{Binding GenerateDetailsCommand}" Content="🚀 Generate 4-View Details &amp; Sheets Now" Height="36" Padding="22,0" Background="#0F172A" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
