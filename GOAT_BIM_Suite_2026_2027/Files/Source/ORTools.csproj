    <Resource Include="Resources\or_grid_16.png" />
    <Resource Include="Resources\SHEETS.jpg" />
    <Resource Include="Resources\or_sheets_32.png" />
    <Resource Include="Resources\or_sheets_16.png" />
    <Resource Include="Resources\PARAMETER.jpg" />
