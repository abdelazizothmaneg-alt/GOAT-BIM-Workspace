<Window x:Class="ORTools.UI.GoatArchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | GOAT ARCH &amp; JOINERY — Parametric Arches &amp; Wardrobe Engine"
        Width="980" Height="680"
        MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP DARK NAVY BANNER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="48" Height="48" Background="Black" BorderBrush="White" BorderThickness="1.5" CornerRadius="6" Margin="0,0,14,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="GOAT" Foreground="White" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="ARCH" Foreground="#10B981" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GOAT ARCH &amp; JOINERY — Parametric Architectural Arches &amp; Wardrobe Builder" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Tab 1: 7 Classical &amp; Islamic Arch Profiles + Host Wall Cut  |  Tab 2: Parametric Cabinetry &amp; Wardrobe Builder" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Revit 2026 / 2027 (.NET 10)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Text="● 3D Solid &amp; Void Ready" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: 2-TAB CONFIGURATION -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                        <UniformGrid Rows="1" Columns="2">
                            <Button x:Name="BtnTabArch" Content="1. Arch Generator" Click="TabBtn_Click" Tag="0" Height="38" Background="White" Foreground="#0F172A" FontWeight="Bold" BorderBrush="#0F172A" BorderThickness="0,0,0,3" Cursor="Hand"/>
                            <Button x:Name="BtnTabWardrobe" Content="2. Wardrobe &amp; Joinery" Click="TabBtn_Click" Tag="1" Height="38" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderBrush="Transparent" BorderThickness="0,0,0,3" Cursor="Hand"/>
                        </UniformGrid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
                        <Grid>
                            <!-- TAB 0: ARCH GENERATOR -->
                            <StackPanel x:Name="PanelArch" Visibility="Visible">
                                <TextBlock Text="Arch Profile &amp; Geometry" Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Arch Profile Type:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CbArchType" Grid.Column="1" Height="28" VerticalContentAlignment="Center" SelectionChanged="ArchInput_Changed">
                                        <ComboBoxItem Content="Semicircular Arch (نصف دائري)" IsSelected="True"/>
                                        <ComboBoxItem Content="Segmental Arch (قوس منخفض)"/>
                                        <ComboBoxItem Content="Pointed / Gothic Arch (عقد مدبب)"/>
                                        <ComboBoxItem Content="Horseshoe / Moorish Arch (حدوة فرس)"/>
                                        <ComboBoxItem Content="Three-Centered Arch (ثلاثي المراكز)"/>
                                        <ComboBoxItem Content="Four-Centered / Tudor Arch (رباعي المراكز)"/>
                                        <ComboBoxItem Content="Ogee Arch (عقد مقلوب / إسلامي)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Clear Span Width (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtArchSpan" Grid.Column="1" Text="1800" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="ArchText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Springing Height (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtArchSpringing" Grid.Column="1" Text="1500" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="ArchText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Arch Rise Height (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtArchRise" Grid.Column="1" Text="900" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="ArchText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Extrusion Depth (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtArchDepth" Grid.Column="1" Text="250" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="ArchText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Masonry Ring Width (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtArchRing" Grid.Column="1" Text="150" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="ArchText_Changed"/>
                                </Grid>

                                <CheckBox x:Name="ChkArchCutWall" Content="Automatically cut opening in selected host wall" IsChecked="True" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,12"/>
                                <TextBlock Text="Tip: Select a Wall in Revit (or click Create Arch to pick a Wall/Point interactively)." Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- TAB 1: WARDROBE & JOINERY -->
                            <StackPanel x:Name="PanelWardrobe" Visibility="Collapsed">
                                <TextBlock Text="Parametric Wardrobe &amp; Joinery Dimensions" Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Width (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtWardWidth" Grid.Column="1" Text="2400" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="WardrobeText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Height (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtWardHeight" Grid.Column="1" Text="2400" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="WardrobeText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cabinet Depth (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtWardDepth" Grid.Column="1" Text="600" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="WardrobeText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Plinth Base Height (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtWardPlinth" Grid.Column="1" Text="80" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="WardrobeText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Board Thickness (mm):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtWardPanelThk" Grid.Column="1" Text="18" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="WardrobeText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vertical Bays (Columns):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtWardBays" Grid.Column="1" Text="3" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="WardrobeText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Shelves per Bay:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtWardShelves" Grid.Column="1" Text="4" Height="28" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" TextChanged="WardrobeText_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Front Doors Style:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CbWardDoorStyle" Grid.Column="1" Height="28" VerticalContentAlignment="Center" SelectionChanged="ArchInput_Changed">
                                        <ComboBoxItem Content="Hinged Doors + Internal Shelves"/>
                                        <ComboBoxItem Content="Sliding Doors + Internal Shelves"/>
                                        <ComboBoxItem Content="Open Walk-in Shelving (No Front Doors)" IsSelected="True"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: LIVE ELEVATION PREVIEW -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock x:Name="TxtPreviewTitle" Text="ELEVATION PREVIEW: Parametric Arch Geometry" Foreground="#0F172A" FontSize="11.5" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Row="1" Background="#F8FAFC" Padding="14">
                        <Canvas x:Name="CanvasArchPreview" ClipToBounds="True" SizeChanged="CanvasArchPreview_SizeChanged"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="6" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Ready — Configure parameters and click Generate." Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Close" Click="BtnClose_Click" Height="36" Padding="16,0" Margin="0,0,10,0" Background="White" BorderBrush="#94A3B8" Foreground="#0F172A" FontWeight="Bold" Cursor="Hand"/>
                    <Button x:Name="BtnGeneratePrimary" Content="🚀 Create Arch in Model" Click="BtnGeneratePrimary_Click" Height="36" Padding="24,0" Background="#0F172A" BorderThickness="0" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
