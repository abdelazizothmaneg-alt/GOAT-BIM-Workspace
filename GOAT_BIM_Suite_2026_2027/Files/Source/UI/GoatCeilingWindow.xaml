<Window x:Class="ORTools.UI.GoatCeilingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | GOAT CEILING — Automated Ceiling &amp; Spatial MEP/Lighting Grid Array"
        Width="1180" Height="780"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP DARK NAVY BANNER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="48" Height="48" Background="Black" BorderBrush="White" BorderThickness="1.5" CornerRadius="6" Margin="0,0,14,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="GOAT" Foreground="White" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="CEILING" Foreground="#10B981" FontSize="8.5" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GOAT CEILING — Automated Ceiling &amp; Spatial MEP/Lighting Grid Array Engine" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Auto-Creates Missing Ceilings · 600×600 Centered Spatial Grid · Face-Hosted &amp; Level-Based Support · Column Clash Avoidance" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Revit 2026 / 2027 (.NET 10)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Text="● RCP Array Engine Ready" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3-COLUMN WORKSPACE -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: ROOMS -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <TextBlock Text="1. Select Rooms" Foreground="#0F172A" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtRoomCount" Text="0 Selected" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="10,10,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="RbActiveView" Grid.Column="0" Content="Active View" IsChecked="True" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,12,0" Checked="Scope_Changed"/>
                        <RadioButton x:Name="RbEntireProject" Grid.Column="1" Content="Entire Project" FontWeight="SemiBold" FontSize="11.5" Checked="Scope_Changed"/>
                        <Button Grid.Column="3" Content="🔄 Refresh" Click="BtnRefresh_Click" FontSize="11" Padding="8,2" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    </Grid>

                    <Border Grid.Row="2" Margin="10,2,10,8" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                        <DataGrid x:Name="DgRooms"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FAFC"
                                  BorderThickness="0"
                                  RowHeight="28"
                                  FontSize="11.5"
                                  SelectionChanged="DgRooms_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="✔" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                                <DataGridTextColumn Header="Room Name" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Ceiling Status" Width="115" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CeilingStatus}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,0,10,10">
                        <Button Content="Select All" Click="BtnSelectAll_Click" FontSize="11" Padding="10,4" Margin="0,0,8,0" Background="White" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        <Button Content="Select None" Click="BtnSelectNone_Click" FontSize="11" Padding="10,4" Background="White" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MIDDLE: SETTINGS TABS -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                        <UniformGrid Rows="1" Columns="3">
                            <Button x:Name="BtnTabGrid" Content="1. Ceiling &amp; Grid" Click="Tab_Click" Tag="0" Height="38" Background="White" Foreground="#0F172A" FontWeight="Bold" BorderBrush="#0F172A" BorderThickness="0,0,0,3" Cursor="Hand"/>
                            <Button x:Name="BtnTabFixtures" Content="2. Lighting &amp; MEP Array" Click="Tab_Click" Tag="1" Height="38" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderBrush="Transparent" BorderThickness="0,0,0,3" Cursor="Hand"/>
                            <Button x:Name="BtnTabRules" Content="3. Clash &amp; Data Rules" Click="Tab_Click" Tag="2" Height="38" Background="#F1F5F9" Foreground="#64748B" FontWeight="Bold" BorderBrush="Transparent" BorderThickness="0,0,0,3" Cursor="Hand"/>
                        </UniformGrid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
                        <Grid>
                            <!-- TAB 0: CEILING & GRID -->
                            <StackPanel x:Name="PanelGrid" Visibility="Visible">
                                <CheckBox x:Name="ChkAutoCreateCeiling" Content="Auto-create missing ceilings in selected rooms" IsChecked="True" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Default Ceiling Type:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CbCeilingTypes" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Default Ceiling Height:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtDefaultHeight" Grid.Column="1" Text="2700" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                    <TextBlock Grid.Column="2" Text="mm above room level" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Spatial Grid Module (Tile Dimensions)" Foreground="#0F172A" FontSize="13" FontWeight="Bold" Margin="0,4,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Grid Tile Width (X):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtTileX" Grid.Column="1" Text="600" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" TextChanged="PreviewSetting_Changed"/>
                                    <TextBlock Grid.Column="2" Text="mm (Standard 600mm)" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Grid Tile Length (Y):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtTileY" Grid.Column="1" Text="600" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" TextChanged="PreviewSetting_Changed"/>
                                    <TextBlock Grid.Column="2" Text="mm (Standard 600 / 1200mm)" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wall Clearance Margin:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtWallMargin" Grid.Column="1" Text="450" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1" TextChanged="PreviewSetting_Changed"/>
                                    <TextBlock Grid.Column="2" Text="mm minimum from walls" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <CheckBox x:Name="ChkCenterGrid" Content="Center spatial grid symmetrically inside room boundaries" IsChecked="True" FontWeight="SemiBold" Foreground="#334155" Checked="PreviewCheck_Changed" Unchecked="PreviewCheck_Changed"/>
                            </StackPanel>

                            <!-- TAB 1: LIGHTING & MEP ARRAY -->
                            <StackPanel x:Name="PanelFixtures" Visibility="Collapsed">
                                <!-- Lighting -->
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkPlaceLighting" Content="Distribute Lighting Fixtures (60×60 / Downlights)" IsChecked="True" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10" Checked="PreviewCheck_Changed" Unchecked="PreviewCheck_Changed"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Lighting Family:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CbLightingSymbols" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="65"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tile Interval Step:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtLightStepX" Grid.Column="1" Text="2" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="PreviewSetting_Changed"/>
                                            <TextBlock Grid.Column="2" Text="tiles X  ×" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBox x:Name="TxtLightStepY" Grid.Column="3" Text="2" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="PreviewSetting_Changed"/>
                                            <TextBlock Grid.Column="4" Text="tiles Y (e.g. 2×2 = every 1200mm)" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Diffusers -->
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkPlaceDiffusers" Content="Distribute HVAC Air Terminals (Diffusers)" IsChecked="False" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10" Checked="PreviewCheck_Changed" Unchecked="PreviewCheck_Changed"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Diffuser Family:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CbDiffuserSymbols" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="65"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tile Interval Step:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtDiffStepX" Grid.Column="1" Text="4" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="PreviewSetting_Changed"/>
                                            <TextBlock Grid.Column="2" Text="tiles X  ×" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBox x:Name="TxtDiffStepY" Grid.Column="3" Text="4" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="PreviewSetting_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Sprinklers -->
                                <StackPanel>
                                    <CheckBox x:Name="ChkPlaceSprinklers" Content="Distribute Fire Sprinklers / Smoke Detectors" IsChecked="False" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10" Checked="PreviewCheck_Changed" Unchecked="PreviewCheck_Changed"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Sprinkler Family:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CbSprinklerSymbols" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="65"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tile Interval Step:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtSpkStepX" Grid.Column="1" Text="5" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="PreviewSetting_Changed"/>
                                        <TextBlock Grid.Column="2" Text="tiles X  ×" VerticalAlignment="Center" Margin="8,0"/>
                                        <TextBox x:Name="TxtSpkStepY" Grid.Column="3" Text="5" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="PreviewSetting_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- TAB 2: CLASH & DATA RULES -->
                            <StackPanel x:Name="PanelRules" Visibility="Collapsed">
                                <TextBlock Text="Host Detection, Clash Avoidance &amp; Room Tagging" Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,14"/>
                                <CheckBox x:Name="ChkAvoidColumns" Content="Avoid structural &amp; architectural columns automatically" IsChecked="True" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,12"/>
                                <CheckBox x:Name="ChkSmartReplace" Content="Smart Replace: Remove old GOAT CEILING fixtures in room before re-generating" IsChecked="True" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,12"/>
                                <CheckBox x:Name="ChkWriteRoomComments" Content="Write Room Number &amp; Name into Fixture Comments parameter" IsChecked="True" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,12"/>
                                <TextBlock Text="Note: GOAT CEILING automatically detects whether your selected families are Face-Hosted, Ceiling-Hosted, or Level-Based and places them at the exact ceiling elevation." Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: LIVE RCP PREVIEW -->
            <Border Grid.Column="4" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,8">
                        <TextBlock Text="RCP PREVIEW: 600×600 Grid &amp; Fixture Array" Foreground="#0F172A" FontSize="11.5" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Row="1" Background="#F8FAFC" Padding="10">
                        <Canvas x:Name="CanvasRcpPreview" ClipToBounds="True" SizeChanged="CanvasRcpPreview_SizeChanged"/>
                    </Border>
                    <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="10,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Lighting" FontSize="11" FontWeight="SemiBold" Margin="0,0,14,0"/>
                            <Ellipse Width="9" Height="9" Fill="#0284C7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Diffuser" FontSize="11" FontWeight="SemiBold" Margin="0,0,14,0"/>
                            <Ellipse Width="9" Height="9" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Sprinkler" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="6" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Ready — Scanning rooms..." Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Click="BtnCancel_Click" Height="36" Padding="16,0" Margin="0,0,10,0" Background="White" BorderBrush="#94A3B8" Foreground="#0F172A" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="🚀 Generate Ceilings &amp; Array" Click="BtnGenerate_Click" Height="36" Padding="24,0" Background="#0F172A" BorderThickness="0" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
