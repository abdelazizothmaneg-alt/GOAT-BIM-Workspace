<Window x:Class="ORTools.UI.GoatAlignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | GOAT ALIGNER — Sheet Auto-Pack, Cross-Sheet Align &amp; Sheet Cloner"
        Width="980" Height="680"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP DARK NAVY BANNER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="48" Height="48" Background="Black" BorderBrush="White" BorderThickness="1.5" CornerRadius="6" Margin="0,0,14,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="GOAT" Foreground="White" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="ALIGN" Foreground="#10B981" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GOAT ALIGNER — Sheet Auto-Pack, Cross-Sheet Viewport Align &amp; Sheet Duplicator" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="1. Glyph-Style Auto-Pack Active Sheet  |  2. Match Viewport/Legend Position Across Sheets  |  3. Duplicate Sheets with Views" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Revit 2026 / 2027 (.NET 10)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Text="● Sheet Delivery Ready" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: TARGET SHEETS LIST -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <TextBlock Text="1. Select Target Sheets" Foreground="#0F172A" FontSize="13" FontWeight="Bold"/>
                            <Button Content="🔄 Refresh" Click="BtnRefresh_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="11" Background="White" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="DgSheets"
                              Grid.Row="1"
                              Margin="10"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              RowHeight="28"
                              FontSize="11.5">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✔" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                            <DataGridTextColumn Header="Sheet Number" Binding="{Binding SheetNumber}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding SheetName}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,10">
                        <Button Content="Select All" Click="BtnSelectAll_Click" FontSize="11" Padding="10,4" Margin="0,0,8,0" Background="White" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        <Button Content="Select None" Click="BtnSelectNone_Click" FontSize="11" Padding="10,4" Background="White" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: 3 OPERATION MODES -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="2. Choose Sheet Delivery &amp; Alignment Operation" Foreground="#0F172A" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>

                    <!-- CARD 1: AUTO-PACK ACTIVE SHEET -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="A. Auto-Pack Viewports on Active / Selected Sheets (Glyph Mode)" Foreground="#0F172A" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Reads Titleblock usable area (excluding right title strip) and arranges all placed Viewports into a balanced, centered grid." Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📐 Auto-Pack Sheets" Click="BtnAutoPack_Click" Height="36" Padding="16,0" Background="#0F172A" Foreground="White" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- CARD 2: CROSS-SHEET ALIGN -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="B. Match Viewport / Legend / Schedule Position Across Sheets" Foreground="#0F172A" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Reference Viewport / Item:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CbReferenceViewports" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Aligns the main Viewport on every checked target sheet to the exact (X, Y) coordinates of the selected Reference Viewport (or copies the selected Legend/Schedule to all checked sheets at the exact same location)." Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="🎯 Match Position Across Checked Sheets" Click="BtnMatchPosition_Click" HorizontalAlignment="Right" Height="34" Padding="16,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: DUPLICATE SHEETS WITH VIEWS -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="C. Duplicate Checked Sheets with Views, Legends &amp; Schedules (CTC Mode)" Foreground="#0F172A" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="RbDupWithDetailing" Content="Duplicate with Detailing" IsChecked="True" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                <RadioButton x:Name="RbDupWithoutDetailing" Content="Duplicate View Only" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                <RadioButton x:Name="RbDupAsDependent" Content="Duplicate as Dependent" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="New Sheet Suffix:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtDupSuffix" Grid.Column="1" Text="-COPY" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                                <Button Grid.Column="3" Content="📑 Duplicate Checked Sheets" Click="BtnDuplicateSheets_Click" Height="34" Padding="16,0" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="6" Padding="16,10">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready — Select target sheets on the left and run an operation." Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Close" Click="BtnClose_Click" HorizontalAlignment="Right" Height="34" Padding="18,0" Background="White" BorderBrush="#94A3B8" Foreground="#0F172A" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
