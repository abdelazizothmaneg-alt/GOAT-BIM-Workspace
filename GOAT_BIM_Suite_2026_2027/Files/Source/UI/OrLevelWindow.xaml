<Window x:Class="ORTools.UI.OrLevelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | GOAT LEVEL — Parametric Level &amp; Floor Plan Generator"
        Height="640" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="ImgHeaderLogo" Grid.Column="0" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GOAT LEVEL — Parametric Floor &amp; Level Generator" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="1. Select Level Type  |  2. Configure Count &amp; Elevations  |  3. Auto-Align Extents &amp; Plans" Foreground="#CBD5E1" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="Revit 2026 / 2027 (.NET 10)" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Level Type Selection Bar (Properties from image) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Level Type Properties:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,12,0"/>
                <ComboBox x:Name="CbLevelTypes" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,2"/>
            </Grid>
        </Border>

        <!-- Generator Parameters Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Floors Count:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtCountParam" Grid.Column="1" Text="5" VerticalContentAlignment="Center" Padding="6,4" BorderBrush="#CBD5E1"/>

                <TextBlock Grid.Column="2" Text="Start Elev (m):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="12,0,6,0"/>
                <TextBox x:Name="TxtStartElevParam" Grid.Column="3" Text="0.00" VerticalContentAlignment="Center" Padding="6,4" BorderBrush="#CBD5E1"/>

                <TextBlock Grid.Column="4" Text="Floor Height (m):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="12,0,6,0"/>
                <TextBox x:Name="TxtStepElevParam" Grid.Column="5" Text="3.60" VerticalContentAlignment="Center" Padding="6,4" BorderBrush="#CBD5E1"/>

                <TextBlock Grid.Column="6" Text="Prefix:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="12,0,6,0"/>
                <TextBox x:Name="TxtPrefixParam" Grid.Column="7" Text="Level " VerticalContentAlignment="Center" Padding="6,4" BorderBrush="#CBD5E1"/>

                <Button x:Name="BtnApplyParameters" Grid.Column="9" Content="Update Table" Click="BtnApplyParameters_Click" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="14,6" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Levels DataGrid -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,12">
            <DataGrid x:Name="DgLevelParameters"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      RowHeight="34"
                      FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding LevelIndex}" Width="45" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="Process" Binding="{Binding CreateLevelParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <DataGridTextColumn Header="Level Name" Binding="{Binding LevelNameParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="Elevation (m)" Binding="{Binding ElevationParameterMeters, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                    <DataGridCheckBoxColumn Header="Add Floor Plan" Binding="{Binding AddToFloorPlansParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Global Option Bar -->
        <Border Grid.Row="4" Background="#F1F5F9" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="ChkGlobalFloorPlansParam"
                          Grid.Column="0"
                          Content="Automatically create Floor Plan views for all selected levels"
                          IsChecked="True"
                          Checked="ChkGlobalFloorPlansParam_Changed"
                          Unchecked="ChkGlobalFloorPlansParam_Changed"
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Foreground="#0F172A"/>

                <Button x:Name="BtnAddFloorRow" Grid.Column="1" Content="+ Add Level" Click="BtnAddFloorRow_Click" Background="White" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,4" Margin="0,0,8,0"/>
                <Button x:Name="BtnRemoveFloorRow" Grid.Column="2" Content="- Remove Selected" Click="BtnRemoveFloorRow_Click" Background="White" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="10,4"/>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Ready. Level Type properties and extents will be applied automatically." VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
            <Button x:Name="BtnCancel" Grid.Column="1" Content="Cancel" Click="BtnCancel_Click" Width="90" Height="38" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,10,0"/>
            <Button x:Name="BtnCreateLevels" Grid.Column="2" Content="Create / Update Levels" Click="BtnCreateLevels_Click" Width="180" Height="38" Background="#0F172A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
