<Window x:Class="ORTools.UI.GoatAnnotateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOAT BIM | GOAT ANNOTATE — Smart Multi-Category Tagging &amp; Anti-Collision Engine"
        Width="780" Height="560"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP DARK NAVY BANNER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="48" Height="48" Background="Black" BorderBrush="White" BorderThickness="1.5" CornerRadius="6" Margin="0,0,14,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="GOAT" Foreground="White" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="TAG" Foreground="#10B981" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GOAT ANNOTATE — Smart Multi-Category Tagging &amp; Anti-Collision Engine" Foreground="White" FontSize="16.5" FontWeight="Bold"/>
                    <TextBlock Text="One-Click Batch Tagging · Automatic Tag Overlap Prevention · Skips Already-Tagged Elements" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Revit 2026 / 2027 (.NET 10)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Text="● Anti-Collision Ready" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Categories Checklist -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="1. Select Categories to Tag in Active View" Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,14"/>
                    <UniformGrid Columns="2">
                        <CheckBox x:Name="ChkCatRooms" Content="Rooms (Room Tags)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkCatDoors" Content="Doors" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkCatWindows" Content="Windows" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkCatWalls" Content="Walls" IsChecked="False" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkCatFloors" Content="Floors" IsChecked="False" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkCatCeilings" Content="Ceilings" IsChecked="False" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkCatFurniture" Content="Furniture" IsChecked="False" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkCatPlumbing" Content="Plumbing Fixtures" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkCatCasework" Content="Casework / Joinery" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkCatLighting" Content="Lighting Fixtures" IsChecked="False" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Anti-Collision & Leader Rules -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="2. Placement &amp; Collision Rules" Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,14"/>
                    <CheckBox x:Name="ChkPreventCollisions" Content="Enable Smart Anti-Collision Engine (Automatically shifts overlapping tags)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <CheckBox x:Name="ChkAddLeaders" Content="Add Tag Leader Lines" IsChecked="False" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock Text="Note: Elements that already have a tag in the active view are automatically skipped to prevent duplicate annotations." Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="6" Padding="16,10">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready — Select categories and click Tag Active View." Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Click="BtnClose_Click" Height="36" Padding="16,0" Margin="0,0,10,0" Background="White" BorderBrush="#94A3B8" Foreground="#0F172A" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="🚀 Tag Active View" Click="BtnTag_Click" Height="36" Padding="24,0" Background="#0F172A" BorderThickness="0" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
