<Window x:Class="SbcBaladyDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="[DEMO تجريبي] مدقق كود البناء السعودي ومنصة بلدي - GOAT BIM" 
        Height="780" Width="1180" 
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#006C35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005228"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Typology Selector Bar -->
            <RowDefinition Height="Auto"/> <!-- Summary Cards -->
            <RowDefinition Height="Auto"/> <!-- Filters & Actions -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Status / Toast Bar -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="#006C35" CornerRadius="12" Padding="20" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="نظام التدقيق المسبق لكود البناء السعودي ومنصة بلدي (SBC Auditor)" 
                                   Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <Border Background="#C5A059" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DEMO تجريبي مستقل" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="معاينة تفاعلية حية لفحص المباني السكنية والتجارية قبل تقديم المعاملة لبلدي" 
                               Foreground="#C8E6C9" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="16,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="نسبة الامتثال للكود:" Foreground="#475569" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtComplianceScore" Text="71.4%" Foreground="#006C35" FontSize="22" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Typology Selector Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" BorderBrush="#CBD5E1" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="🏗️ نوع وتصنيف المبنى المعروض:" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>

                <ComboBox Grid.Column="1" x:Name="CmbTypology" Height="34" FontSize="13" SelectionChanged="CmbTypology_SelectionChanged">
                    <ComboBoxItem Content="🏡 نموذج فيلا سكنية خاصة (حي الياسمين)" Tag="Villa" IsSelected="True"/>
                    <ComboBoxItem Content="🏢 نموذج عمائر شقق سكنية (مشروع الواحة)" Tag="Apartments"/>
                    <ComboBoxItem Content="🏪 نموذج تجاري - محلات ومعارض (سيتي ووك)" Tag="Retail"/>
                    <ComboBoxItem Content="🏬 نموذج إداري - مكاتب وشركات (برج الأعمال)" Tag="Office"/>
                    <ComboBoxItem Content="🏙️ نموذج سكني تجاري مختلط (بوليفارد)" Tag="Mixed"/>
                </ComboBox>

                <TextBlock Grid.Column="2" x:Name="TxtTypologyHint" Text="معايير الفلل: نسبة البناء 60%، ارتداد 2م، موقف سيارة واحد، عرض الدرج 900مم." 
                           Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="3" Content="⚡ إعادة الفحص الآن" Style="{StaticResource ActionButton}" Padding="12,6" Click="BtnReAudit_Click"/>
            </Grid>
        </Border>

        <!-- 3. Summary Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي بنود الفحص" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalChecks" Text="7" Foreground="#0F172A" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,10,0" BorderBrush="#FFCDD2" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="مخالفات صريحة (تسبب الرفض)" Foreground="#D32F2F" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtViolations" Text="2" Foreground="#D32F2F" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14" Margin="0,0,10,0" BorderBrush="#FFE0B2" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ملاحظات وتنبيهات" Foreground="#F57C00" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtWarnings" Text="1" Foreground="#F57C00" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="14" BorderBrush="#C8E6C9" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="بنود مطابقة للكود" Foreground="#2E7D32" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtPassed" Text="4" Foreground="#2E7D32" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Toolbar & Actions -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="تصفية حسب:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbFilterCategory" Width="200" Height="32" SelectionChanged="CmbFilterCategory_SelectionChanged">
                        <ComboBoxItem Content="جميع البنود" IsSelected="True"/>
                        <ComboBoxItem Content="المخالفات فقط (مرفوض)"/>
                        <ComboBoxItem Content="التنبيهات فقط"/>
                        <ComboBoxItem Content="المعماري (SBC 201)"/>
                        <ComboBoxItem Content="اشتراطات بلدي والارتدادات"/>
                        <ComboBoxItem Content="معايير مواقف السيارات"/>
                        <ComboBoxItem Content="التعارض الإنشائي"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="🔍 محاكاة تحديد العنصر" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnSelectElement_Click"/>
                    <Button Content="🟥 محاكاة تلوين الموديل" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnColorize_Click"/>
                    <Button Content="👁️ محاكاة عزل 3D" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnIsolate_Click"/>
                    <Button Content="📄 تصدير تقرير بلدي المعتمد (HTML/PDF)" Style="{StaticResource ActionButton}" Click="BtnExportReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. DataGrid of Results -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="GridResults" AutoGenerateColumns="False" IsReadOnly="True" 
                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" RowHeight="42" Background="White"
                      BorderThickness="0" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding SeverityLabel}" Width="120"/>
                    <DataGridTextColumn Header="مرجع الكود" Binding="{Binding RuleCode}" Width="140"/>
                    <DataGridTextColumn Header="العنصر" Binding="{Binding ElementName}" Width="160"/>
                    <DataGridTextColumn Header="الوصف الفني للمخالفة والتوصية" Binding="{Binding FullDescription}" Width="*"/>
                    <DataGridTextColumn Header="القيمة المسجلة" Binding="{Binding CurrentValue}" Width="110"/>
                    <DataGridTextColumn Header="الحد النظامي" Binding="{Binding AllowedRange}" Width="140"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 6. Status / Toast Bar -->
        <Border Grid.Row="5" x:Name="StatusToast" Background="#EFF6FF" CornerRadius="6" Padding="12,8" Margin="0,8,0,0" BorderBrush="#BFDBFE" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="TxtStatusMessage" Text="جاهز." Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- 7. Footer -->
        <TextBlock Grid.Row="6" Text="GOAT BIM Suite © 2026 - نظام الأتمتة والذكاء الاصطناعي لكود البناء السعودي (DEMO التجريبي المباشر)" 
                   Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </Grid>
</Window>
